# ─────────────────────────────────────────────
#  Exness AutoTrader — Configuration
#  Copy this to .env and fill in your details
# ─────────────────────────────────────────────

# MT5 Login Credentials (from Exness portal)
MT5_LOGIN=YOUR_LOGIN_ID
MT5_PASSWORD=YOUR_PASSWORD
MT5_SERVER=YOUR_SERVER

# Trading Pairs (comma-separated, no trailing comma!)
SYMBOLS=EURUSDm,GBPUSDm,USDJPYm,XAUUSDm

# Timeframe: M1 M5 M15 M30 H1 H4 D1
TIMEFRAME=H1

# Risk Settings
DAILY_PROFIT_TARGET_PCT=4.0
DAILY_LOSS_LIMIT_PCT=2.0
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_TRADES=3

# Trailing Stop (ATR multiplier — 2.0 recommended for H1)
ATR_TRAIL_MULTIPLIER=2.0
ATR_PERIOD=14

# Strategy Parameters
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Minimum confidence % to take a trade (0-100)
MIN_CONFIDENCE=72

# Telegram Alerts (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_NUMERIC_CHAT_ID

# News Filter — pause trading N minutes before/after red news
NEWS_FILTER_ENABLED=true
NEWS_PAUSE_MINUTES=30

# Gemini AI Advisor (get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true

# Session Filter — only trade during optimal hours per pair
SESSION_FILTER_ENABLED=true

# Multi-Timeframe Filter — require H4 trend confirmation
MTF_ENABLED=true

# ADX Regime Filter — skip trades in ranging markets
ADX_FILTER_ENABLED=true
ADX_MIN_TREND=20

# Discord Notifications (webhook — no bot token needed!)
# Setup: Server Settings → Integrations → Webhooks → New → Copy URL
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL
DISCORD_BOT_NAME=Exness AutoTrader
DISCORD_AVATAR_URL=

# Logging
LOG_LEVEL=INFO
